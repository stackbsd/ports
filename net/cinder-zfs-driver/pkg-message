[
{ type: install
  message: <<EOM
Enable the backend in %%PREFIX%%/etc/cinder/cinder.conf:

    [DEFAULT]
    enabled_backends = zfs
    default_volume_type = zfs

    [zfs]
    volume_driver = cinder_zfs_driver.driver.ZFSVolumeDriver
    volume_backend_name = ZFS
    zfs_dataset = zroot/cinder
    zfs_sparse_volumes = true
    use_chap_auth = true

Host prerequisites:

  - the cinder user holds ZFS delegated administration on the dataset:
        zfs create zroot/cinder
        zfs allow -u cinder clone,compression,create,destroy,mount,promote,receive,refreservation,rollback,send,snapshot,userprop,volblocksize,volmode,volsize zroot/cinder
  - remote iSCSI export needs ctld running against the file the driver
    writes.  ctld refuses an empty config, so seed it with the portal
    group before the first start:
        install -d -m 0750 -o cinder -g cinder /var/db/cinder
        printf 'portal-group "cinder" {\n    discovery-auth-group no-authentication\n    listen 127.0.0.1:3260\n}\n' > /var/db/cinder/ctl.conf
        chown cinder:cinder /var/db/cinder/ctl.conf
        sysrc ctld_flags="-f /var/db/cinder/ctl.conf" ctld_enable=YES
        service ctld start
  - migration to a backend on another host sends zvols over ssh. Give the
    cinder user a key and point migration_ssh_config in the backend section
    at a file naming it:
        Host *
            User cinder-migrate
            IdentityFile %%PREFIX%%/etc/cinder/migrate_key
            UserKnownHostsFile %%PREFIX%%/etc/cinder/known_hosts
    On the receiving host the cinder-migrate user receives it:
        zfs allow -u cinder-migrate create,destroy,receive,refreservation zroot/cinder
    and pins each sender's key in /var/db/cinder-migrate/.ssh/authorized_keys:
        command="cinder-zfs-receive",restrict ssh-ed25519 AAAA... cinder@storage1
EOM
}
]
