nova ALL = (root) NOPASSWD: %%VENV%%/bin/privsep-helper --config-file %%PREFIX%%/etc/nova/nova.conf --privsep_context nova.privsep.sys_admin_pctxt --privsep_sock_path /tmp/*/privsep.sock
nova ALL = (root) NOPASSWD: %%VENV%%/bin/privsep-helper --config-file %%PREFIX%%/etc/nova/nova.conf --privsep_context os_brick.privileged.default --privsep_sock_path /tmp/*/privsep.sock
nova ALL = (root) NOPASSWD: %%VENV%%/bin/privsep-helper --config-file %%PREFIX%%/etc/nova/nova.conf --privsep_context os_brick.privileged.brick_privsep_hide_output --privsep_sock_path /tmp/*/privsep.sock
nova ALL = (root) NOPASSWD: %%PREFIX%%/bin/nova-rootwrap %%PREFIX%%/etc/nova/rootwrap.conf *
