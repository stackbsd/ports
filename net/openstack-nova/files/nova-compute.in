#!/bin/sh

# PROVIDE: nova_compute
# REQUIRE: LOGIN
# KEYWORD: shutdown

. /etc/rc.subr

name=nova_compute
rcvar=nova_compute_enable
desc="Nova compute service"

load_rc_config $name

: ${nova_compute_enable:="NO"}
: ${nova_compute_run_user:="nova"}
: ${nova_compute_statedir:="/var/db/nova"}
: ${nova_compute_pidfile:="/var/run/${name}.pid"}
: ${nova_compute_logfile:="/var/log/${name}.log"}
: ${nova_compute_stop_timeout:="30"}

pidfile="${nova_compute_pidfile}"
command="/usr/sbin/daemon"
command_args="-c -r -H -t ${name} -u ${nova_compute_run_user} \
	-P ${pidfile} -o ${nova_compute_logfile} \
	%%PREFIX%%/bin/nova-compute"

start_precmd="nova_compute_precmd"

nova_compute_precmd()
{
	/usr/bin/install -d -o "${nova_compute_run_user}" \
		-g "${nova_compute_run_user}" -m 0750 \
		"${nova_compute_statedir}" \
		"${nova_compute_statedir}/tmp" \
		"${nova_compute_statedir}/instances"
}

stop_cmd="nova_compute_stop"

nova_compute_stop()
{
	local child
	child=$(pgrep -P ${rc_pid})
	echo "Stopping ${name}."
	kill -TERM ${rc_pid}
	pwait -t ${nova_compute_stop_timeout} ${rc_pid} 2> /dev/null && return 0
	echo "${name} did not exit in ${nova_compute_stop_timeout}s, killing it."
	kill -KILL -- -${rc_pid} -${child} 2> /dev/null
	rm -f ${pidfile}
}

run_rc_command "$1"
