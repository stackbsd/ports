#!/bin/sh

# PROVIDE: nova_api
# REQUIRE: LOGIN
# KEYWORD: shutdown

. /etc/rc.subr

name=nova_api
rcvar=nova_api_enable
desc="Nova API server"

load_rc_config $name

: ${nova_api_enable:="NO"}
: ${nova_api_runas:="nova"}
: ${nova_api_statedir:="/var/db/nova"}
: ${nova_api_pidfile:="/var/run/${name}.pid"}
: ${nova_api_logfile:="/var/log/${name}.log"}
: ${nova_api_stop_timeout:="30"}

pidfile="${nova_api_pidfile}"
command="/usr/sbin/daemon"
command_args="-c -r -H -t ${name} -u ${nova_api_runas} \
	-P ${pidfile} -o ${nova_api_logfile} \
	%%PREFIX%%/bin/nova-api"

start_precmd="nova_api_precmd"

nova_api_precmd()
{
	/usr/bin/install -d -o "${nova_api_runas}" -g "${nova_api_runas}" \
		-m 0750 \
		"${nova_api_statedir}" \
		"${nova_api_statedir}/tmp"
}

stop_cmd="nova_api_stop"

nova_api_stop()
{
	local child
	child=$(pgrep -P ${rc_pid})
	echo "Stopping ${name}."
	kill -TERM ${rc_pid}
	pwait -t ${nova_api_stop_timeout} ${rc_pid} 2> /dev/null && return 0
	echo "${name} did not exit in ${nova_api_stop_timeout}s, killing it."
	kill -KILL -- -${rc_pid} -${child} 2> /dev/null
	rm -f ${pidfile}
}

run_rc_command "$1"
