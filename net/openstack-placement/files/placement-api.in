#!/bin/sh

# PROVIDE: placement_api
# REQUIRE: LOGIN
# KEYWORD: shutdown

. /etc/rc.subr

name=placement_api
rcvar=placement_api_enable
desc="Placement API server"

load_rc_config $name

: ${placement_api_enable:="NO"}
: ${placement_api_run_user:="placement"}
: ${placement_api_pidfile:="/var/run/${name}.pid"}
: ${placement_api_logfile:="/var/log/${name}.log"}
: ${placement_api_stop_timeout:="30"}

pidfile="${placement_api_pidfile}"
command="/usr/sbin/daemon"
command_args="-c -r -H -t ${name} -u ${placement_api_run_user} \
	-P ${pidfile} -o ${placement_api_logfile} \
	%%PREFIX%%/bin/placement-api"

stop_cmd="placement_api_stop"

placement_api_stop()
{
	local child
	child=$(pgrep -P ${rc_pid})
	echo "Stopping ${name}."
	kill -TERM ${rc_pid}
	pwait -t ${placement_api_stop_timeout} ${rc_pid} 2> /dev/null && return 0
	echo "${name} did not exit in ${placement_api_stop_timeout}s, killing it."
	kill -KILL -- -${rc_pid} -${child} 2> /dev/null
	rm -f ${pidfile}
}

run_rc_command "$1"
