#!/bin/sh

# PROVIDE: neutron_api
# REQUIRE: LOGIN
# KEYWORD: shutdown

. /etc/rc.subr

name=neutron_api
rcvar=neutron_api_enable
desc="Neutron API server"

load_rc_config $name

: ${neutron_api_enable:="NO"}
: ${neutron_api_runas:="neutron"}
: ${neutron_api_statedir:="/var/db/neutron"}
: ${neutron_api_pidfile:="/var/run/${name}.pid"}
: ${neutron_api_logfile:="/var/log/${name}.log"}
: ${neutron_api_stop_timeout:="30"}

pidfile="${neutron_api_pidfile}"
command="/usr/sbin/daemon"
command_args="-c -r -H -t ${name} -u ${neutron_api_runas} \
	-P ${pidfile} -o ${neutron_api_logfile} \
	%%PREFIX%%/bin/neutron-api"

start_precmd="neutron_api_precmd"

neutron_api_precmd()
{
	/usr/bin/install -d -o "${neutron_api_runas}" -g "${neutron_api_runas}" \
		-m 0750 \
		"${neutron_api_statedir}" \
		"${neutron_api_statedir}/tmp"
}

stop_cmd="neutron_api_stop"

neutron_api_stop()
{
	local child
	child=$(pgrep -P ${rc_pid})
	echo "Stopping ${name}."
	kill -TERM ${rc_pid}
	pwait -t ${neutron_api_stop_timeout} ${rc_pid} 2> /dev/null && return 0
	echo "${name} did not exit in ${neutron_api_stop_timeout}s, killing it."
	kill -KILL -- -${rc_pid} -${child} 2> /dev/null
	rm -f ${pidfile}
}

run_rc_command "$1"
