#!/bin/sh
export GUNICORN_CMD_ARGS="-c python:gunicorn_env_cfg"
export GUNICORN_WSGI_APP="neutron.wsgi.api:application"
export GUNICORN_CONTROL_SOCKET_DISABLE=True
export OS_NEUTRON_CONFIG_DIR="%%PREFIX%%/etc/neutron/"
set -a
. %%PREFIX%%/etc/neutron/neutron-wsgi.conf
set +a
exec %%VENV%%/bin/gunicorn
