#!/bin/sh

# PROVIDE: horizon
# REQUIRE: LOGIN
# KEYWORD: shutdown

. /etc/rc.subr

name=horizon
rcvar=horizon_enable
desc="Horizon dashboard server"

load_rc_config $name

: ${horizon_enable:="NO"}
: ${horizon_runas:="horizon"}
: ${horizon_statedir:="/var/db/horizon"}
: ${horizon_pidfile:="/var/run/${name}.pid"}
: ${horizon_logfile:="/var/log/${name}.log"}

pidfile="${horizon_pidfile}"
command="/usr/sbin/daemon"
command_args="-c -r -H -t ${name} -u ${horizon_runas} \
	-P ${pidfile} -o ${horizon_logfile} \
	%%PREFIX%%/bin/horizon"

start_precmd="horizon_precmd"

horizon_precmd()
{
	/usr/bin/install -d -o "${horizon_runas}" -g "${horizon_runas}" \
		-m 0750 "${horizon_statedir}"
}

run_rc_command "$1"
