#!/bin/sh

# PROVIDE: glance_api
# REQUIRE: LOGIN
# KEYWORD: shutdown

. /etc/rc.subr

name=glance_api
rcvar=glance_api_enable
desc="Glance API server"

load_rc_config $name

: ${glance_api_enable:="NO"}
: ${glance_api_run_user:="glance"}
: ${glance_api_datadir:="/var/db/glance"}
: ${glance_api_pidfile:="/var/run/${name}.pid"}
: ${glance_api_logfile:="/var/log/${name}.log"}
: ${glance_api_stop_timeout:="30"}

pidfile="${glance_api_pidfile}"
command="/usr/sbin/daemon"
command_args="-c -r -H -t ${name} -u ${glance_api_run_user} \
	-P ${pidfile} -o ${glance_api_logfile} \
	%%PREFIX%%/bin/glance-api"

start_precmd="glance_api_precmd"

glance_api_precmd()
{
	/usr/bin/install -d -o "${glance_api_run_user}" -g "${glance_api_run_user}" \
		-m 0750 \
		"${glance_api_datadir}" \
		"${glance_api_datadir}/images" \
		"${glance_api_datadir}/staging" \
		"${glance_api_datadir}/tasks"
}

stop_cmd="glance_api_stop"

glance_api_stop()
{
	local child
	child=$(pgrep -P ${rc_pid})
	echo "Stopping ${name}."
	kill -TERM ${rc_pid}
	pwait -t ${glance_api_stop_timeout} ${rc_pid} 2> /dev/null && return 0
	echo "${name} did not exit in ${glance_api_stop_timeout}s, killing it."
	kill -KILL -- -${rc_pid} -${child} 2> /dev/null
	rm -f ${pidfile}
}

run_rc_command "$1"
