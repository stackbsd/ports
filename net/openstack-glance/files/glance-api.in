#!/bin/sh

# PROVIDE: glance_api
# REQUIRE: LOGIN
# KEYWORD: shutdown

. /etc/rc.subr

name=glance_api
rcvar=glance_api_enable
desc="Glance API server"

load_rc_config $name

: ${glance_api_enable:="NO"}
: ${glance_api_runas:="glance"}
: ${glance_api_datadir:="/var/db/glance"}
: ${glance_api_pidfile:="/var/run/${name}.pid"}
: ${glance_api_logfile:="/var/log/${name}.log"}

pidfile="${glance_api_pidfile}"
command="/usr/sbin/daemon"
command_args="-c -r -H -t ${name} -u ${glance_api_runas} \
	-P ${pidfile} -o ${glance_api_logfile} \
	%%PREFIX%%/bin/glance-api"

start_precmd="glance_api_precmd"

glance_api_precmd()
{
	/usr/bin/install -d -o "${glance_api_runas}" -g "${glance_api_runas}" \
		-m 0750 \
		"${glance_api_datadir}" \
		"${glance_api_datadir}/images" \
		"${glance_api_datadir}/staging" \
		"${glance_api_datadir}/tasks"
}

run_rc_command "$1"
