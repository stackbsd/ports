[DEFAULT]
enabled_backends = fs:file
metadata_source_path = %%PREFIX%%/etc/glance/metadefs

[database]
# connection = mysql+pymysql://glance:GLANCE_DBPASS@localhost/glance
# connection = mysql+pymysql://glance@/glance?unix_socket=/var/run/mysql/mysql.sock

[glance_store]
default_backend = fs

[fs]
filesystem_store_datadir = /var/db/glance/images
filesystem_thin_provisioning = true

[os_glance_staging_store]
filesystem_store_datadir = /var/db/glance/staging

[os_glance_tasks_store]
filesystem_store_datadir = /var/db/glance/tasks

[paste_deploy]
flavor = keystone

[keystone_authtoken]
# www_authenticate_uri = http://localhost:5000/v3
# auth_url = http://localhost:5000/v3
# memcached_servers = localhost:11211
# auth_type = password
# project_domain_name = Default
# user_domain_name = Default
# project_name = service
# username = glance
# password = GLANCE_PASS
