#!/bin/sh
export GUNICORN_CMD_ARGS="-c python:gunicorn_env_cfg"
export GUNICORN_WSGI_APP="keystone.wsgi.api:application"
export GUNICORN_CONTROL_SOCKET_DISABLE=True
export OS_KEYSTONE_CONFIG_DIR="%%PREFIX%%/etc/keystone/"
set -a
. %%PREFIX%%/etc/keystone/keystone-wsgi.conf
set +a
exec %%VENV%%/bin/gunicorn
