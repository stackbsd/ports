#!/bin/sh

# PROVIDE: neutron_bsdbridge_l2_agent
# REQUIRE: NETWORKING FILESYSTEMS devd
# BEFORE: jail
# KEYWORD: shutdown

. /etc/rc.subr

name=neutron_bsdbridge_l2_agent
rcvar=neutron_bsdbridge_l2_agent_enable
desc="neutron-bsdbridge L2 agent"

load_rc_config $name

: ${neutron_bsdbridge_l2_agent_enable:="NO"}
: ${neutron_bsdbridge_l2_agent_pidfile:="/var/run/${name}.pid"}
: ${neutron_bsdbridge_l2_agent_logfile:="/var/log/${name}.log"}
: ${neutron_bsdbridge_l2_agent_stop_timeout:="30"}

pidfile="${neutron_bsdbridge_l2_agent_pidfile}"
command="/usr/sbin/daemon"
# runs as root because it creates bridges and taps and loads pf anchors
command_args="-c -r -H -t ${name} \
	-P ${pidfile} -o ${neutron_bsdbridge_l2_agent_logfile} \
	%%PREFIX%%/bin/neutron-bsdbridge-l2-agent"

stop_cmd="neutron_bsdbridge_l2_agent_stop"

neutron_bsdbridge_l2_agent_stop()
{
	local child
	child=$(pgrep -P ${rc_pid})
	echo "Stopping ${name}."
	kill -TERM ${rc_pid}
	pwait -t ${neutron_bsdbridge_l2_agent_stop_timeout} ${rc_pid} 2> /dev/null && return 0
	echo "${name} did not exit in ${neutron_bsdbridge_l2_agent_stop_timeout}s, killing it."
	kill -KILL -- -${rc_pid} -${child} 2> /dev/null
	rm -f ${pidfile}
}

run_rc_command "$1"
