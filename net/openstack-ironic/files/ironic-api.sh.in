#!/bin/sh
export GUNICORN_CMD_ARGS="-c python:gunicorn_env_cfg"
export GUNICORN_WSGI_APP="ironic.wsgi:application"
export GUNICORN_CONTROL_SOCKET_DISABLE=True
export IRONIC_CONFIG_FILE="%%PREFIX%%/etc/ironic/ironic.conf"
set -a
. %%PREFIX%%/etc/ironic/ironic-wsgi.conf
set +a
exec %%VENV%%/bin/gunicorn
