#!/bin/sh

# PROVIDE: cinder_volume
# REQUIRE: LOGIN
# KEYWORD: shutdown

. /etc/rc.subr

name=cinder_volume
rcvar=cinder_volume_enable
desc="Cinder volume service"

load_rc_config $name

: ${cinder_volume_enable:="NO"}
: ${cinder_volume_runas:="cinder"}
: ${cinder_volume_statedir:="/var/db/cinder"}
: ${cinder_volume_pidfile:="/var/run/${name}.pid"}
: ${cinder_volume_logfile:="/var/log/${name}.log"}
: ${cinder_volume_stop_timeout:="30"}

pidfile="${cinder_volume_pidfile}"
command="/usr/sbin/daemon"
command_args="-c -r -H -t ${name} -u ${cinder_volume_runas} \
	-P ${pidfile} -o ${cinder_volume_logfile} \
	%%PREFIX%%/bin/cinder-volume"

start_precmd="cinder_volume_precmd"

cinder_volume_precmd()
{
	/usr/bin/install -d -o "${cinder_volume_runas}" \
		-g "${cinder_volume_runas}" -m 0750 \
		"${cinder_volume_statedir}" \
		"${cinder_volume_statedir}/tmp" \
		"${cinder_volume_statedir}/conversion"
}

stop_cmd="cinder_volume_stop"

cinder_volume_stop()
{
	local child
	child=$(pgrep -P ${rc_pid})
	echo "Stopping ${name}."
	kill -TERM ${rc_pid}
	pwait -t ${cinder_volume_stop_timeout} ${rc_pid} 2> /dev/null && return 0
	echo "${name} did not exit in ${cinder_volume_stop_timeout}s, killing it."
	kill -KILL -- -${rc_pid} -${child} 2> /dev/null
	rm -f ${pidfile}
}

run_rc_command "$1"
