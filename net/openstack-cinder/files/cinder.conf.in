[DEFAULT]
auth_strategy = keystone
state_path = /var/db/cinder
rootwrap_config = %%PREFIX%%/etc/cinder/rootwrap.conf

# transport_url = rabbit://username:password@localhost:5672/
# my_ip = 127.0.0.1
# enabled_backends = zfs
# default_volume_type = zfs

[database]
# connection = mysql+pymysql://cinder:CINDER_DBPASS@localhost/cinder
# connection = mysql+pymysql://cinder@/cinder?unix_socket=/var/run/mysql/mysql.sock

[keystone_authtoken]
# www_authenticate_uri = http://localhost:5000/v3
# auth_url = http://localhost:5000/v3
# memcached_servers = localhost:11211
# auth_type = password
# project_domain_name = Default
# user_domain_name = Default
# project_name = service
# username = cinder
# password = CINDER_PASS

[oslo_concurrency]
lock_path = /var/db/cinder/tmp

[cinder_sys_admin]
helper_command = sudo %%VENV%%/bin/privsep-helper --config-file %%PREFIX%%/etc/cinder/cinder.conf

[privsep_osbrick]
helper_command = sudo %%VENV%%/bin/privsep-helper --config-file %%PREFIX%%/etc/cinder/cinder.conf

